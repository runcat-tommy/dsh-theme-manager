{
  "name": "dsh-theme-manager",
  "description": "Two-level theme manager for DeepSeek Harness Web: pick a culture/scene first, then a style (China·Ink Wash, Japan·Ukiyo-e, …). 两级主题管理器：先选文化/场景，再选风格（中国·水墨、日本·浮世绘…）。",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "files": [
    "cordis.patch.yml",
    "lib"
  ],
  "license": "MIT"
}
